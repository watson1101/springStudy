# cart-service
server.port=9010
spring.application.name=item-service
spring.cloud.nacos.discovery.server-addr=192.168.2.10:8848


mybatis.config-location=classpath:mybatis/mybatis-config.xml
mybatis.mapper-locations=classpath:mybatis/mapper/*.xml
#mybatis.type-aliases-package=com.yy.domain
mybatis.type-aliases-package=com.hong.domain

#spring.datasource.url=jdbc:mysql://localhost:3306/yy?serverTimezone=UTC&useUnicode=true&characterEncoding=utf-8&useSSL=true
spring.database.mysql.host=192.168.2.10
spring.datasource.url=jdbc:mysql://${spring.database.mysql.host}:3306/test?serverTimezone=UTC&useUnicode=true&characterEncoding=utf-8&useSSL=true
spring.datasource.username=hong
spring.datasource.password=123456
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver