<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="msdemo.hong.com.goods.mapper.ProductMapper">

    <!-- 商品结果映射 -->
    <resultMap id="BaseResultMap" type="msdemo.hong.com.goods.model.entity.Product">
        <id column="id" property="id" jdbcType="BIGINT" javaType="java.lang.Long"/>
        <result column="product_name" property="productName"/>
        <result column="product_code" property="productCode"/>
        <result column="category_id" property="categoryId" jdbcType="BIGINT" javaType="java.lang.Long"/>
        <result column="category_name" property="categoryName"/>
        <result column="brand" property="brand"/>
        <result column="price" property="price"/>
        <result column="original_price" property="originalPrice"/>
        <result column="cost_price" property="costPrice"/>
        <result column="stock_quantity" property="stockQuantity"/>
        <result column="frozen_stock" property="frozenStock"/>
        <result column="status" property="status"/>
        <result column="is_deleted" property="isDeleted"/>
        <result column="description" property="description"/>
        <result column="specification" property="specification"/>
        <result column="images" property="images"/>
        <result column="sales_count" property="salesCount"/>
        <result column="comment_count" property="commentCount"/>
        <result column="rating" property="rating"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="create_by" property="createBy"/>
        <result column="update_by" property="updateBy"/>
    </resultMap>

    <!-- 通用查询列 -->
    <sql id="BaseColumns">
        id, product_name, product_code, category_id, category_name, brand,
        price, original_price, cost_price, stock_quantity, frozen_stock,
        status, is_deleted, description, specification, images,
        sales_count, comment_count, rating, create_time, update_time,
        create_by, update_by
    </sql>

    <!-- 根据商品编码查询商品 -->
    <select id="selectByProductCode" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM goods_product
        WHERE product_code = #{productCode}
        LIMIT 1
    </select>

    <!-- 批量查询商品信息 -->
    <select id="selectByIds" resultMap="BaseResultMap">
        SELECT <include refid="BaseColumns"/>
        FROM goods_product
        WHERE id IN
        <foreach collection="productIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        AND is_deleted = 0
    </select>

    <!-- 扣减库存 -->
    <update id="deductStock">
        UPDATE goods_product
        SET
            stock_quantity = stock_quantity - #{quantity},
            frozen_stock = frozen_stock - #{quantity}
        WHERE id = #{productId}
          AND frozen_stock >= #{quantity}
    </update>

    <!-- 释放冻结库存 -->
    <update id="releaseFrozenStock">
        UPDATE goods_product
        SET
            frozen_stock = frozen_stock - #{quantity},
            stock_quantity = stock_quantity + #{quantity}
        WHERE id = #{productId}
          AND frozen_stock >= #{quantity}
    </update>

    <!-- 冻结库存 -->
    <update id="freezeStock">
        UPDATE goods_product
        SET
            frozen_stock = frozen_stock + #{quantity},
            stock_quantity = stock_quantity - #{quantity}
        WHERE id = #{productId}
          AND stock_quantity >= #{quantity}
    </update>

</mapper>