{
  "name": "memo-app",
  "version": "1.0.0",
  "description": "备忘录与提醒应用",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:portable": "electron-builder --win portable"
  },
  "author": "watson",
  "license": "MIT",
  "dependencies": {
    "mysql2": "^3.11.0",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.watson.memo",
    "productName": "MemoApp",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "sign": null
    }
  }
}
