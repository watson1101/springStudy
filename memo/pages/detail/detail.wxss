/* detail.wxss */
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 24rpx;
  padding-bottom: 200rpx;
}

.detail-card {
  background: white;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

/* 标题区域 */
.title-section {
  margin-bottom: 24rpx;
}

.title-input {
  font-size: 40rpx;
  font-weight: 600;
  color: #333;
  width: 100%;
}

/* 内容区域 */
.content-section {
  margin-bottom: 32rpx;
  padding-bottom: 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.content-input {
  font-size: 30rpx;
  color: #666;
  line-height: 1.8;
  width: 100%;
  min-height: 200rpx;
}

/* 图片区域 */
.images-section {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 32rpx;
  padding-bottom: 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.image-item {
  width: 200rpx;
  height: 200rpx;
}

.memo-image {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

/* 提醒设置 */
.remind-section {
  margin-bottom: 32rpx;
  padding-bottom: 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.remind-time-picker {
  margin-top: 24rpx;
}

.picker-display {
  padding: 24rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.picker-display text {
  font-size: 28rpx;
  color: #333;
}

.quick-select {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.quick-btn {
  flex: 1;
  min-width: 180rpx;
  padding: 20rpx;
  background: #f0f9ff;
  color: #1890ff;
  border: 1rpx solid #bae7ff;
  border-radius: 8rpx;
  font-size: 26rpx;
}

.quick-btn::after {
  border: none;
}

/* AI分析区域 */
.ai-section {
  margin-bottom: 32rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #f6ffed 0%, #d9f7be 100%);
  border-radius: 12rpx;
}

.ai-result {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.ai-item {
  font-size: 26rpx;
  color: #389e0d;
}

/* 元信息区域 */
.meta-section {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.meta-text {
  font-size: 24rpx;
  color: #999;
}

/* 操作按钮 */
.action-buttons {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 24rpx;
  padding: 24rpx;
  background: white;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.action-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 12rpx;
  font-size: 32rpx;
}

.action-btn::after {
  border: none;
}

.delete-btn {
  background: #fff1f0;
  color: #ff4d4f;
  border: 1rpx solid #ffccc7;
}

.save-btn {
  background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
  color: white;
}

/* 订阅消息区域 */
.subscribe-section {
  position: fixed;
  bottom: 150rpx;
  left: 24rpx;
  right: 24rpx;
  padding: 24rpx;
  background: white;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.subscribe-btn {
  width: 100%;
  background: linear-gradient(135deg, #722ed1 0%, #531dab 100%);
  color: white;
  border: none;
  border-radius: 8rpx;
  padding: 24rpx;
  font-size: 28rpx;
}

.subscribe-btn::after {
  border: none;
}

.subscribe-tip {
  font-size: 24rpx;
  color: #999;
}
