/* index.wxss */
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

/* 输入区域 */
.input-section {
  position: sticky;
  top: 0;
  z-index: 100;
  background-color: #f5f5f5;
  padding-bottom: 20rpx;
}

.input-box {
  background: white;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.memo-input {
  width: 100%;
  min-height: 120rpx;
  font-size: 32rpx;
  line-height: 1.6;
  color: #333;
}

.input-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.action-left {
  display: flex;
  align-items: center;
}

.icon-btn {
  background: #f5f5f5;
  border: none;
  padding: 16rpx 24rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.icon-btn::after {
  border: none;
}

.send-btn {
  background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
  color: white;
  border: none;
  padding: 16rpx 40rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.send-btn::after {
  border: none;
}

.send-btn[disabled] {
  background: #d9d9d9;
}

/* 图片预览 */
.image-preview {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
}

.preview-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}

.preview-image {
  width: 100%;
  height: 100%;
  border-radius: 8rpx;
}

.remove-btn {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.6);
  color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  line-height: 1;
}

/* AI提示 */
.ai-tip {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  margin: 0 24rpx;
  background: linear-gradient(135deg, #e6f7ff 0%, #bae7ff 100%);
  border-radius: 12rpx;
  border-left: 4rpx solid #1890ff;
}

.tip-icon {
  font-size: 32rpx;
}

.tip-text {
  font-size: 26rpx;
  color: #0050b3;
  flex: 1;
}

/* 备忘列表 */
.memo-list {
  padding: 0 24rpx;
}

.list-header {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
}

.header-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.header-count {
  font-size: 28rpx;
  color: #999;
  margin-left: 8rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.3;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 备忘项 */
.memo-item {
  background: white;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  position: relative;
  transition: all 0.3s;
}

.memo-item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 24rpx;
  bottom: 24rpx;
  width: 6rpx;
  background: #d9d9d9;
  border-radius: 0 4rpx 4rpx 0;
}

.memo-item.pending::before {
  background: linear-gradient(180deg, #1890ff 0%, #096dd9 100%);
}

.memo-item.reminded::before {
  background: linear-gradient(180deg, #ff4d4f 0%, #cf1322 100%);
}

.memo-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.memo-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  flex: 1;
}

.memo-badge {
  width: 16rpx;
  height: 16rpx;
  margin-left: 12rpx;
}

.badge-dot {
  display: block;
  width: 100%;
  height: 100%;
  background: #1890ff;
  border-radius: 50%;
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0%, 100% {
    opacity: 1;
    transform: scale(1);
  }
  50% {
    opacity: 0.5;
    transform: scale(1.2);
  }
}

.memo-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.memo-images {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.memo-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
}

.memo-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.remind-info {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.remind-icon {
  font-size: 28rpx;
}

.remind-text {
  font-size: 24rpx;
  color: #1890ff;
}

.remind-status {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  background: #fff1f0;
  color: #ff4d4f;
  border-radius: 4rpx;
}

.memo-time {
  font-size: 24rpx;
  color: #999;
}

/* 按钮hover效果 */
.btn-hover {
  opacity: 0.8;
  transform: scale(0.98);
}
